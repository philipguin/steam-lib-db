# Reference only. The CLI does not load .env files automatically.
GOOGLE_SHEET_ID=YOUR_SPREADSHEET_ID
STEAM_ID=YOUR_STEAM_ID64
STEAM_API_KEY=YOUR_STEAM_API_KEY
GOOGLE_APPLICATION_CREDENTIALS=/path/outside/the/repository/service-account.json
# In CI, set GOOGLE_CREDENTIALS_JSON as a secret instead of a file path.
